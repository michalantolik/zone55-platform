# =============================================================================
# Zone55.Management — Multi-stage Dockerfile (Blazor WebAssembly + Nginx)
# Build context: repo root
# =============================================================================

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS restore
WORKDIR /src

COPY src/LearnKit/LearnKit.Domain/LearnKit.Domain.csproj          src/LearnKit/LearnKit.Domain/
COPY src/Zone55/Zone55.Management/Zone55.Management.csproj       src/Zone55/Zone55.Management/

RUN dotnet restore src/Zone55/Zone55.Management/Zone55.Management.csproj

FROM restore AS publish
WORKDIR /src

COPY src/LearnKit/LearnKit.Domain/  src/LearnKit/LearnKit.Domain/
COPY src/Zone55/Zone55.Management/  src/Zone55/Zone55.Management/

RUN dotnet publish src/Zone55/Zone55.Management/Zone55.Management.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM nginx:1.27-alpine AS runtime

ARG MANAGEMENT_API_BASE_URL=http://localhost:5000/
ARG MANAGEMENT_PORTAL_BASE_URL=http://localhost:8080/

RUN rm -rf /usr/share/nginx/html/*

COPY --from=publish /app/publish/wwwroot /usr/share/nginx/html
COPY src/Zone55/Zone55.Management/nginx.conf /etc/nginx/conf.d/default.conf

RUN sed -i "s#https://YOUR_API_APP_SERVICE_URL/#${MANAGEMENT_API_BASE_URL}#g" \
        /usr/share/nginx/html/appsettings.Production.json \
    && sed -i "s#https://zone55.pl/#${MANAGEMENT_PORTAL_BASE_URL}#g" \
        /usr/share/nginx/html/appsettings.Production.json

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
