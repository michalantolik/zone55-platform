@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject PreviewDiagnosticsClient Diagnostics

<div class="preview-workspace">
    <div class="preview-workspace__toolbar">
        <div>
            <strong>Portal article preview</strong>
            <span>Rendered by BlogPlatform.App from the current unsaved draft.</span>
            <code>@PreviewUrl</code>
        </div>
        <div class="preview-workspace__actions">
            <span class="preview-status preview-status--@_connectionState.ToString().ToLowerInvariant()">
                @ConnectionLabel
            </span>
            <a class="preview-open-link" href="@PreviewUrl" target="_blank" rel="noopener noreferrer">
                Open preview page
            </a>
        </div>
    </div>

    <div class="preview-frame-shell">
        <iframe @ref="_previewFrame"
                src="@PreviewUrl"
                title="Article preview"
                loading="eager"
                sandbox="allow-scripts allow-same-origin"
                referrerpolicy="strict-origin-when-cross-origin">
        </iframe>
    </div>

    @if (_connectionState == PreviewConnectionState.Unavailable)
    {
        <p class="preview-runtime-note preview-runtime-note--error" role="alert">
            The portal preview did not become ready. Start BlogPlatform.App and verify the configured
            <code>Portal:BaseUrl</code> value.
        </p>
    }
    else if (_connectionState == PreviewConnectionState.Failed)
    {
        <p class="preview-runtime-note preview-runtime-note--error" role="alert">
            The portal caught a preview error. @_lastError
        </p>
    }
    else
    {
        <p class="preview-runtime-note">
            Metadata and valid unsaved block changes are sent directly to the portal renderer. Invalid draft JSON
            remains in the editor and is omitted until it becomes valid.
        </p>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "preview";
    [Parameter] public string Title { get; set; } = "Untitled article";
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string BodyContent { get; set; } = "[]";

    private const string PreviewSlugFallback = "preview";
    private string _portalOrigin = string.Empty;
    private string _previewUrl = string.Empty;
    private ElementReference _previewFrame;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ArticlePreviewWorkspace>? _objectReference;
    private PreviewConnectionState _connectionState = PreviewConnectionState.Connecting;
    private int _payloadVersion;
    private int _sentPayloadVersion = -1;
    private bool _connected;
    private string? _lastError;
    private int _lastBlockFailureCount;
    private readonly string _sessionId = Guid.NewGuid().ToString("N");

    private string PreviewUrl => _previewUrl;

    private string ConnectionLabel => _connectionState switch
    {
        PreviewConnectionState.Connecting => "Connecting to portal",
        PreviewConnectionState.Ready => "Portal ready",
        PreviewConnectionState.Rendered => _lastBlockFailureCount > 0
            ? $"Rendered with {_lastBlockFailureCount} block error(s)"
            : "Draft rendered",
        PreviewConnectionState.Failed => "Render failed",
        PreviewConnectionState.Unavailable => "Portal unavailable",
        _ => "Preview status unknown"
    };

    protected override void OnInitialized()
    {
        var configuredBaseUrl = Configuration["Portal:BaseUrl"];
        if (string.IsNullOrWhiteSpace(configuredBaseUrl))
        {
            throw new InvalidOperationException("Portal:BaseUrl is missing.");
        }

        var portalBaseUri = new Uri(configuredBaseUrl, UriKind.Absolute);
        _portalOrigin = portalBaseUri.GetLeftPart(UriPartial.Authority);
        _previewUrl = new Uri(portalBaseUri, "preview/article").AbsoluteUri;
        Track("Management.Initialized", 0, $"PortalOrigin={_portalOrigin}; PreviewUrl={_previewUrl}; DiagnosticsEnabled={Diagnostics.Enabled}");
    }

    protected override void OnParametersSet()
    {
        _payloadVersion++;
        Track("Management.ParametersChanged", _payloadVersion, $"Slug={Normalize(Slug, PreviewSlugFallback)}; TitleLength={Title?.Length ?? 0}; SummaryLength={Summary?.Length ?? 0}; BodyLength={BodyContent?.Length ?? 0}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/article-preview-workspace.js");
            _objectReference = DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync(
                "connectArticlePreview",
                _previewFrame,
                _objectReference,
                _portalOrigin,
                Diagnostics.Enabled,
                _sessionId);

            Track("Management.Connected", 0, "Preview iframe bridge connected.");

            _connected = true;
        }

        if (_connected && _module is not null && _sentPayloadVersion != _payloadVersion)
        {
            _sentPayloadVersion = _payloadVersion;
            _connectionState = PreviewConnectionState.Connecting;

            Track("Management.PayloadDispatch", _payloadVersion, $"Slug={Normalize(Slug, PreviewSlugFallback)}; TitleLength={Title?.Length ?? 0}; SummaryLength={Summary?.Length ?? 0}; BodyLength={BodyContent?.Length ?? 0}");

            await _module.InvokeVoidAsync(
                "sendArticlePreview",
                _previewFrame,
                new PreviewArticlePayload(
                    Normalize(Slug, PreviewSlugFallback),
                    Normalize(Title, "Untitled article"),
                    Summary,
                    BodyContent));
        }
    }

    [JSInvokable]
    public Task NotifyPreviewReady()
    {
        _connectionState = PreviewConnectionState.Ready;
        Track("Management.PreviewReady", 0, "Portal reported ready.");
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task NotifyPreviewRendered(int blockFailureCount)
    {
        _lastError = null;
        _lastBlockFailureCount = Math.Max(0, blockFailureCount);
        _connectionState = PreviewConnectionState.Rendered;
        Track("Management.PreviewRendered", _sentPayloadVersion, $"BlockFailures={_lastBlockFailureCount}");
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task NotifyPreviewFailed(string? message)
    {
        _lastError = string.IsNullOrWhiteSpace(message)
            ? "Unknown preview error. Check the App and API logs for LIVE_PREVIEW entries."
            : message;
        _connectionState = PreviewConnectionState.Failed;
        Track("Management.PreviewFailed", _sentPayloadVersion, _lastError);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task NotifyPreviewUnavailable()
    {
        if (_connectionState is not PreviewConnectionState.Ready and not PreviewConnectionState.Rendered)
        {
            _connectionState = PreviewConnectionState.Unavailable;
            Track("Management.PreviewUnavailable", 0, "Portal did not report ready before timeout.");
        }

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task NotifyPreviewDiagnostic(string eventName, int sequence, string message)
    {
        Track($"Management.Js.{eventName}", sequence, message);
        return Task.CompletedTask;
    }

    private void Track(string eventName, int sequence, string? message)
    {
        if (!Diagnostics.Enabled) return;
        var safeMessage = string.IsNullOrWhiteSpace(message) ? "-" : message;
        Console.WriteLine($"[LIVE_PREVIEW] Session={_sessionId}; Event={eventName}; Sequence={sequence}; {safeMessage}");
        _ = Diagnostics.WriteAsync(_sessionId, eventName, sequence, safeMessage);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnectArticlePreview", _previewFrame);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser session has already ended.
            }
            catch (JSException)
            {
                // The preview frame may already be unloading during client-side navigation.
            }
            catch (ObjectDisposedException)
            {
                // The imported JavaScript module was disposed as part of navigation.
            }
        }

        _objectReference?.Dispose();
    }

    private static string Normalize(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private sealed record PreviewArticlePayload(
        string Slug,
        string Title,
        string? Summary,
        string BodyHtml);

    private enum PreviewConnectionState
    {
        Connecting,
        Ready,
        Rendered,
        Failed,
        Unavailable
    }
}
