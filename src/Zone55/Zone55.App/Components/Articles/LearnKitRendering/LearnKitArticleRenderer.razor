@using Zone55.App.Components.Articles.Shared
@using Zone55.App.Models.LearnKit
@using Zone55.App.Models.LearnKit.Articles
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (Article is not null)
{
    <article class="article-card" @key="Article.Id + Article.Title + Article.Summary">
        <div class="tag-row">
        </div>

        <h1>@Article.Title</h1>

        <div class="article-meta">
            <strong>Engineering note</strong>
            <span>·</span>
            <span>Michał Antolik</span>
            <span>·</span>
        </div>

        <div class="article-summary">
            @MarkdownRenderer.Render(Article.Summary)
        </div>

        <div class="article-body">
            <CascadingValue Value="_plantUmlTheme">
                <CascadingValue Value="CopyToClipboardDelegate">
                    @foreach (var block in Article.Blocks.OrderBy(block => block.SortOrder))
                    {
                        <SafeLearnKitBlockRenderer Block="block"
                                                   OnRenderFailure="HandleBlockRenderFailureAsync"
                                                   @key="block.Id + block.ContentJson" />
                    }
                </CascadingValue>
            </CascadingValue>
        </div>
    </article>
}

@code {
    [Parameter]
    public LearnKitArticleDetails? Article { get; set; }

    [Parameter]
    public EventCallback<BlockRenderFailure> OnBlockRenderFailure { get; set; }

    private Func<string?, Task> CopyToClipboardDelegate => CopyToClipboardAsync;

    private PlantUmlThemeValues _plantUmlTheme = new(
        "#a7b4c8",
        "#E5E7EB",
        "#7d8ca3",
        "#374151",
        "SansSerif");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _plantUmlTheme = await JS.InvokeAsync<PlantUmlThemeValues>(
                    "blogPlatformArticle.getPlantUmlThemeValues");

                StateHasChanged();
            }
            catch (JSException ex)
            {
                Console.Error.WriteLine($"LearnKit PlantUML theme lookup failed: {ex}");
            }
        }

        try
        {
            await JS.InvokeVoidAsync("blogPlatformArticle.renderDiagrams");
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine($"LearnKit diagram rendering failed: {ex}");
        }
    }

    private Task HandleBlockRenderFailureAsync(BlockRenderFailure failure)
    {
        return OnBlockRenderFailure.HasDelegate
            ? OnBlockRenderFailure.InvokeAsync(failure)
            : Task.CompletedTask;
    }

    private async Task CopyToClipboardAsync(string? value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            await JS.InvokeVoidAsync("blogPlatformArticle.copyToClipboard", value);
        }
    }
}
