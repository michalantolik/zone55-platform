<section class="ui-section @Class">
    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Description) || Actions is not null)
    {
        <header class="ui-section-header">
            <div>
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2 class="ui-section-title">@Title</h2>
                }
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="ui-section-description">@Description</p>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="ui-inline">@Actions</div>
            }
        </header>
    }
    @ChildContent
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
