<header class="ui-page-header @Class">
    <div class="ui-page-header-copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <span class="ui-page-eyebrow">@Eyebrow</span>
        }
        <h1 class="ui-page-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="ui-page-description">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="ui-page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
