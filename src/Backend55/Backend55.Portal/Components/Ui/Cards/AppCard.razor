<section class="@CssClass" @attributes="AdditionalAttributes">
    @if (Header is not null)
    {
        <header class="ui-card-header">@Header</header>
    }
    @ChildContent
    @if (Footer is not null)
    {
        <footer class="ui-card-footer">@Footer</footer>
    }
</section>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => $"ui-card{(Interactive ? " ui-card-interactive" : string.Empty)}{(string.IsNullOrWhiteSpace(Class) ? string.Empty : $" {Class}")}";
}
