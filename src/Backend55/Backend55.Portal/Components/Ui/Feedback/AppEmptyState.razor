@using Backend55.Portal.Components.Common

<div class="ui-empty-state @Class">
    <div class="ui-empty-state-content">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="ui-empty-state-icon" aria-hidden="true"><AppIcon Name="@Icon" /></span>
        }
        <h3>@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p>@Description</p>
        }
        @if (Actions is not null)
        {
            <div class="ui-inline">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
