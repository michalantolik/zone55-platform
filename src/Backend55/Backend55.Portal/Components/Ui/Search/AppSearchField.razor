@using Backend55.Portal.Components.Common

<label class="ui-search @Class">
    <AppIcon Name="search" />
    <input value="@Value"
           @oninput="HandleInput"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           disabled="@Disabled"
           @attributes="InputAttributes" />

    @if (ShowClear && !string.IsNullOrWhiteSpace(Value))
    {
        <button type="button"
                class="ui-search-clear"
                aria-label="@ClearLabel"
                title="@ClearLabel"
                @onclick="ClearAsync">
            <AppIcon Name="close" />
        </button>
    }
</label>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string ClearLabel { get; set; } = "Clear";
    [Parameter] public bool ShowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public IReadOnlyDictionary<string, object>? InputAttributes { get; set; }

    private Task HandleInput(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    private Task ClearAsync() => ValueChanged.InvokeAsync(string.Empty);
}
