<div class="@CssClass" aria-disabled="@Disabled.ToString().ToLowerInvariant()">
    <div class="ui-field-heading">
        <label class="ui-label" for="@For">
            @Label@if (Required)
            {
                <span class="ui-required" aria-hidden="true"> *</span>
            }
        </label>
        @if (LabelAction is not null)
        {
            @LabelAction
        }
    </div>

    @ChildContent

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <p class="ui-help" id="@HelpId">@HelpText</p>
    }

    @if (ValidationContent is not null)
    {
        <div class="ui-error" role="alert">@ValidationContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? For { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? LabelAction { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ValidationContent { get; set; }

    private string? HelpId => string.IsNullOrWhiteSpace(For) || string.IsNullOrWhiteSpace(HelpText)
        ? null
        : $"{For}-help";

    private string CssClass =>
        $"ui-field" +
        (Wide ? " ui-field-wide" : string.Empty) +
        (Disabled ? " ui-field-disabled" : string.Empty) +
        (string.IsNullOrWhiteSpace(Class) ? string.Empty : $" {Class}");
}
