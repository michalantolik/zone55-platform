@using Backend55.Portal.Components.Common

<AppButton Variant="@Variant"
           Size="@Size"
           IconOnly="true"
           Disabled="@Disabled"
           Title="@Title"
           AriaLabel="@AriaLabel"
           Class="@Class"
           OnClick="@OnClick"
           AdditionalAttributes="@AdditionalAttributes">
    <AppIcon Name="@Icon" />
</AppButton>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public string Variant { get; set; } = "ghost";
    [Parameter] public string Size { get; set; } = "medium";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
