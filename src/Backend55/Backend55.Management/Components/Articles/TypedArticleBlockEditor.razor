@using System.Text.Json

<div class="typed-block-editor">
    <div class="typed-block-editor__toolbar">
        <span>@EditorDescription</span>
        <button class="text-button" type="button" @onclick="ToggleAdvanced">
            @(_showAdvanced ? "Use form editor" : "Advanced JSON")
        </button>
    </div>

    @if (_showAdvanced)
    {
        <label class="form-field form-field--full">
            <span>Content JSON</span>
            <textarea class="block-json-editor" rows="14" spellcheck="false" value="@Value" @oninput="OnAdvancedJsonInput"></textarea>
        </label>
    }
    else
    {
        @switch (Type)
        {
            case "Markdown":
                <label class="form-field form-field--full">
                    <span>Markdown</span>
                    <textarea class="block-content-editor" rows="14" @bind="Markdown" @bind:event="oninput"></textarea>
                </label>
                break;
            case "Code":
                <div class="form-grid">
                    <label class="form-field"><span>Language</span><input @bind="Language" @bind:event="oninput" /></label>
                    <label class="form-field"><span>File name</span><input @bind="FileName" @bind:event="oninput" /></label>
                    <label class="form-field"><span>Title</span><input @bind="CodeTitle" @bind:event="oninput" /></label>
                    <label class="check-field"><input type="checkbox" @bind="ShowTitleBar" /><span>Show title bar</span></label>
                    <label class="form-field form-field--full"><span>Code</span><textarea class="block-content-editor block-content-editor--code" rows="16" spellcheck="false" @bind="Code" @bind:event="oninput"></textarea></label>
                </div>
                break;
            case "Diagram":
                <div class="form-grid">
                    <label class="form-field"><span>Diagram type</span><select @bind="DiagramType"><option value="plantuml">PlantUML</option><option value="mermaid">Mermaid</option></select></label>
                    <label class="form-field"><span>Title</span><input @bind="DiagramTitle" @bind:event="oninput" /></label>
                    <label class="check-field"><input type="checkbox" @bind="ShowTitleBar" /><span>Show title bar</span></label>
                    <label class="form-field form-field--full"><span>Diagram source</span><textarea class="block-content-editor block-content-editor--code" rows="16" spellcheck="false" @bind="Diagram" @bind:event="oninput"></textarea></label>
                    <small class="form-field--full">The preview uses the same renderer as the public Portal.</small>
                </div>
                break;
            case "Callout":
                <div class="form-grid">
                    <label class="form-field"><span>Kind</span><select @bind="Kind"><option value="info">Info</option><option value="note">Note</option><option value="warning">Warning</option><option value="success">Success</option><option value="danger">Danger</option></select></label>
                    <label class="form-field form-field--full"><span>Text</span><textarea class="block-content-editor" rows="8" @bind="Text" @bind:event="oninput"></textarea></label>
                </div>
                break;
            case "Summary":
                <label class="form-field form-field--full"><span>Summary</span><textarea class="block-content-editor" rows="10" @bind="Summary" @bind:event="oninput"></textarea></label>
                break;
            case "Table":
                <div class="table-block-editor">
                    <div class="form-grid">
                        <label class="form-field"><span>Style</span><select @bind="TableStyle"><option value="dense-engineering">Dense engineering</option><option value="minimal-reference">Minimal reference</option></select></label>
                        <label class="form-field"><span>Default alignment</span><select @bind="HorizontalAlignment"><option value="left">Left</option><option value="center">Center</option><option value="right">Right</option></select></label>
                        <label class="check-field"><input type="checkbox" @bind="HasHeaderRow" /><span>Header row</span></label>
                        <label class="check-field"><input type="checkbox" @bind="HasHeaderColumn" /><span>Header column</span></label>
                        <label class="check-field"><input type="checkbox" @bind="AutoNumberRows" /><span>Number rows</span></label>
                    </div>

                    <div class="table-editor-toolbar" role="toolbar" aria-label="Table structure">
                        <span>@_tableRows.Count rows × @ColumnCount columns</span>
                        <button class="secondary-button secondary-button--compact" type="button" @onclick="AddRow">＋ Row</button>
                        <button class="secondary-button secondary-button--compact" type="button" @onclick="AddColumn">＋ Column</button>
                    </div>

                    <div class="table-editor-scroll">
                        <table class="table-editor-grid">
                            <thead>
                                <tr>
                                    <th class="table-editor-corner"></th>
                                    @for (var columnIndex = 0; columnIndex < ColumnCount; columnIndex++)
                                    {
                                        var capturedColumn = columnIndex;
                                        <th>
                                            <span>Column @(columnIndex + 1)</span>
                                            <button type="button" class="table-editor-remove" title="Delete column" @onclick="() => RemoveColumn(capturedColumn)" disabled="@(ColumnCount <= 1)">×</button>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var rowIndex = 0; rowIndex < _tableRows.Count; rowIndex++)
                                {
                                    var capturedRow = rowIndex;
                                    <tr>
                                        <th>
                                            <span>Row @(rowIndex + 1)</span>
                                            <button type="button" class="table-editor-remove" title="Delete row" @onclick="() => RemoveRow(capturedRow)" disabled="@(_tableRows.Count <= 1)">×</button>
                                        </th>
                                        @for (var columnIndex = 0; columnIndex < ColumnCount; columnIndex++)
                                        {
                                            var capturedColumn = columnIndex;
                                            var cell = _tableRows[rowIndex][columnIndex];
                                            <td class="@GetCellCssClass(rowIndex, columnIndex)">
                                                <textarea rows="3" placeholder="Cell content" value="@cell.Text" @onfocus="() => SelectCell(capturedRow, capturedColumn)" @oninput="args => UpdateCellText(cell, args)"></textarea>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (SelectedCell is not null)
                    {
                        <div class="table-cell-editor">
                            <div class="table-cell-editor__title">Cell @(_selectedRow + 1), @(_selectedColumn + 1)</div>
                            <div class="form-grid">
                                <label class="form-field"><span>Horizontal alignment</span><select value="@SelectedCell.HorizontalAlignment" @onchange="UpdateSelectedHorizontalAlignment"><option value="">Use table default</option><option value="left">Left</option><option value="center">Center</option><option value="right">Right</option></select></label>
                                <label class="form-field"><span>Vertical alignment</span><select value="@SelectedCell.VerticalAlignment" @onchange="UpdateSelectedVerticalAlignment"><option value="">Use table default</option><option value="top">Top</option><option value="middle">Middle</option><option value="bottom">Bottom</option></select></label>
                                <label class="form-field"><span>Emoji</span><input value="@SelectedCell.Emoji" @oninput="UpdateSelectedEmoji" /></label>
                                <label class="form-field"><span>Image URL</span><input value="@SelectedCell.ImageUrl" @oninput="UpdateSelectedImageUrl" /></label>
                                <label class="form-field form-field--full"><span>Image alt text</span><input value="@SelectedCell.ImageAlt" @oninput="UpdateSelectedImageAlt" /></label>
                            </div>
                        </div>
                    }
                </div>
                break;
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string Type { get; set; } = "Markdown";
    [Parameter] public string Value { get; set; } = "{}";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private string _loadedType = string.Empty;
    private string _loadedValue = string.Empty;
    private bool _showAdvanced;
    private bool _suppressPublish;

    private string _markdown = string.Empty, _code = string.Empty, _language = "csharp", _fileName = string.Empty, _codeTitle = string.Empty;
    private string _diagram = string.Empty, _diagramTitle = string.Empty, _diagramType = "plantuml", _kind = "info", _text = string.Empty, _summary = string.Empty;
    private string _tableStyle = "dense-engineering", _horizontalAlignment = "left";
    private bool _showTitleBar = true, _hasHeaderRow = true, _hasHeaderColumn, _autoNumberRows;
    private readonly List<List<TableCellEditorModel>> _tableRows = [];
    private int _selectedRow;
    private int _selectedColumn;

    private string Markdown { get => _markdown; set { _markdown = value; Publish(); } }
    private string Code { get => _code; set { _code = value; Publish(); } }
    private string Language { get => _language; set { _language = value; Publish(); } }
    private string FileName { get => _fileName; set { _fileName = value; Publish(); } }
    private string CodeTitle { get => _codeTitle; set { _codeTitle = value; Publish(); } }
    private string Diagram { get => _diagram; set { _diagram = value; Publish(); } }
    private string DiagramTitle { get => _diagramTitle; set { _diagramTitle = value; Publish(); } }
    private string DiagramType { get => _diagramType; set { _diagramType = value; Publish(); } }
    private string Kind { get => _kind; set { _kind = value; Publish(); } }
    private string Text { get => _text; set { _text = value; Publish(); } }
    private string Summary { get => _summary; set { _summary = value; Publish(); } }
    private string TableStyle { get => _tableStyle; set { _tableStyle = value; Publish(); } }
    private string HorizontalAlignment { get => _horizontalAlignment; set { _horizontalAlignment = value; Publish(); } }
    private bool ShowTitleBar { get => _showTitleBar; set { _showTitleBar = value; Publish(); } }
    private bool HasHeaderRow { get => _hasHeaderRow; set { _hasHeaderRow = value; Publish(); } }
    private bool HasHeaderColumn { get => _hasHeaderColumn; set { _hasHeaderColumn = value; Publish(); } }
    private bool AutoNumberRows { get => _autoNumberRows; set { _autoNumberRows = value; Publish(); } }

    private int ColumnCount => _tableRows.Count == 0 ? 0 : _tableRows.Max(row => row.Count);
    private TableCellEditorModel? SelectedCell =>
        _selectedRow >= 0 && _selectedRow < _tableRows.Count &&
        _selectedColumn >= 0 && _selectedColumn < _tableRows[_selectedRow].Count
            ? _tableRows[_selectedRow][_selectedColumn]
            : null;

    private string EditorDescription => Type switch
    {
        "Markdown" => "Write article text using Markdown.",
        "Code" => "Configure the code sample and its optional title bar.",
        "Diagram" => "Edit PlantUML or Mermaid source and preview it in the portal renderer.",
        "Table" => "Build the table visually. Advanced JSON remains available for uncommon cell metadata.",
        "Callout" => "Create a highlighted note, warning or information block.",
        "Summary" => "Add a compact article summary block.",
        _ => "Edit block content."
    };

    protected override void OnParametersSet()
    {
        if (_loadedType == Type && _loadedValue == Value)
        {
            return;
        }

        _loadedType = Type;
        _loadedValue = Value;
        LoadValue();
    }

    private void LoadValue()
    {
        _suppressPublish = true;
        try
        {
            using var document = JsonDocument.Parse(string.IsNullOrWhiteSpace(Value) ? "{}" : Value);
            var root = document.RootElement;
            _markdown = String(root, "markdown") ?? String(root, "text") ?? string.Empty;
            _code = String(root, "code") ?? string.Empty;
            _language = String(root, "language") ?? "csharp";
            _fileName = String(root, "fileName") ?? string.Empty;
            _codeTitle = String(root, "codeTitle") ?? String(root, "title") ?? string.Empty;
            _diagram = String(root, "diagram") ?? String(root, "plantUml") ?? String(root, "mermaid") ?? string.Empty;
            _diagramTitle = String(root, "title") ?? string.Empty;
            _diagramType = NormalizeDiagramType(String(root, "diagramType"), _diagram);
            _kind = String(root, "kind") ?? "info";
            _text = String(root, "text") ?? string.Empty;
            _summary = String(root, "summary") ?? string.Empty;
            _showTitleBar = Bool(root, "showCodeTitleBar") ?? Bool(root, "showDiagramTitleBar") ?? true;
            _tableStyle = String(root, "tableStyle") ?? "dense-engineering";
            _horizontalAlignment = String(root, "defaultHorizontalAlignment") ?? "left";
            _hasHeaderRow = Bool(root, "hasHeaderRow") ?? true;
            _hasHeaderColumn = Bool(root, "hasHeaderColumn") ?? false;
            _autoNumberRows = Bool(root, "autoNumberRows") ?? false;
            LoadTableRows(root);
            _showAdvanced = false;
        }
        catch (JsonException)
        {
            _showAdvanced = true;
        }
        finally
        {
            _suppressPublish = false;
        }
    }

    private void LoadTableRows(JsonElement root)
    {
        _tableRows.Clear();

        if (root.TryGetProperty("rows", out var rows) && rows.ValueKind == JsonValueKind.Array)
        {
            foreach (var rowElement in rows.EnumerateArray())
            {
                if (rowElement.ValueKind != JsonValueKind.Array)
                {
                    continue;
                }

                var row = new List<TableCellEditorModel>();
                foreach (var cellElement in rowElement.EnumerateArray())
                {
                    row.Add(ParseCell(cellElement));
                }

                if (row.Count > 0)
                {
                    _tableRows.Add(row);
                }
            }
        }

        if (_tableRows.Count == 0)
        {
            _tableRows.AddRange(CreateRows(3, 3));
        }

        NormalizeTableShape();
        _selectedRow = 0;
        _selectedColumn = 0;
    }

    private static TableCellEditorModel ParseCell(JsonElement cell)
    {
        if (cell.ValueKind == JsonValueKind.String)
        {
            return new TableCellEditorModel { Text = cell.GetString() ?? string.Empty };
        }

        if (cell.ValueKind != JsonValueKind.Object)
        {
            return new TableCellEditorModel();
        }

        return new TableCellEditorModel
        {
            Text = String(cell, "text") ?? string.Empty,
            Emoji = String(cell, "emoji") ?? string.Empty,
            ImageUrl = String(cell, "imageUrl") ?? string.Empty,
            ImageAlt = String(cell, "imageAlt") ?? string.Empty,
            HorizontalAlignment = String(cell, "horizontalAlignment") ?? string.Empty,
            VerticalAlignment = String(cell, "verticalAlignment") ?? string.Empty
        };
    }

    private void NormalizeTableShape()
    {
        var columnCount = Math.Max(1, _tableRows.Max(row => row.Count));
        foreach (var row in _tableRows)
        {
            while (row.Count < columnCount)
            {
                row.Add(new TableCellEditorModel());
            }
        }
    }

    private static IEnumerable<List<TableCellEditorModel>> CreateRows(int rowCount, int columnCount)
    {
        for (var row = 0; row < rowCount; row++)
        {
            yield return Enumerable.Range(0, columnCount).Select(_ => new TableCellEditorModel()).ToList();
        }
    }

    private void AddRow()
    {
        _tableRows.Add(Enumerable.Range(0, Math.Max(1, ColumnCount)).Select(_ => new TableCellEditorModel()).ToList());
        _selectedRow = _tableRows.Count - 1;
        _selectedColumn = 0;
        Publish();
    }

    private void RemoveRow(int rowIndex)
    {
        if (_tableRows.Count <= 1 || rowIndex < 0 || rowIndex >= _tableRows.Count)
        {
            return;
        }

        _tableRows.RemoveAt(rowIndex);
        _selectedRow = Math.Min(_selectedRow, _tableRows.Count - 1);
        Publish();
    }

    private void AddColumn()
    {
        foreach (var row in _tableRows)
        {
            row.Add(new TableCellEditorModel());
        }

        _selectedColumn = ColumnCount - 1;
        Publish();
    }

    private void RemoveColumn(int columnIndex)
    {
        if (ColumnCount <= 1 || columnIndex < 0 || columnIndex >= ColumnCount)
        {
            return;
        }

        foreach (var row in _tableRows)
        {
            row.RemoveAt(columnIndex);
        }

        _selectedColumn = Math.Min(_selectedColumn, ColumnCount - 1);
        Publish();
    }

    private void SelectCell(int rowIndex, int columnIndex)
    {
        _selectedRow = rowIndex;
        _selectedColumn = columnIndex;
    }

    private string GetCellCssClass(int rowIndex, int columnIndex) =>
        rowIndex == _selectedRow && columnIndex == _selectedColumn ? "is-selected" : string.Empty;

    private void UpdateCellText(TableCellEditorModel cell, ChangeEventArgs args)
    {
        cell.Text = args.Value?.ToString() ?? string.Empty;
        Publish();
    }

    private void UpdateSelectedHorizontalAlignment(ChangeEventArgs args) => UpdateSelectedCell(cell => cell.HorizontalAlignment = args.Value?.ToString() ?? string.Empty);
    private void UpdateSelectedVerticalAlignment(ChangeEventArgs args) => UpdateSelectedCell(cell => cell.VerticalAlignment = args.Value?.ToString() ?? string.Empty);
    private void UpdateSelectedEmoji(ChangeEventArgs args) => UpdateSelectedCell(cell => cell.Emoji = args.Value?.ToString() ?? string.Empty);
    private void UpdateSelectedImageUrl(ChangeEventArgs args) => UpdateSelectedCell(cell => cell.ImageUrl = args.Value?.ToString() ?? string.Empty);
    private void UpdateSelectedImageAlt(ChangeEventArgs args) => UpdateSelectedCell(cell => cell.ImageAlt = args.Value?.ToString() ?? string.Empty);

    private void UpdateSelectedCell(Action<TableCellEditorModel> update)
    {
        if (SelectedCell is null)
        {
            return;
        }

        update(SelectedCell);
        Publish();
    }

    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;

    private async Task OnAdvancedJsonInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        _loadedValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    private void Publish()
    {
        if (_suppressPublish)
        {
            return;
        }

        var value = SerializeValue();
        _loadedValue = value;
        _ = ValueChanged.InvokeAsync(value);
    }

    private string SerializeValue()
    {
        object content = Type switch
        {
            "Code" => new { code = _code, language = EmptyToNull(_language), fileName = EmptyToNull(_fileName), codeTitle = EmptyToNull(_codeTitle), showCodeTitleBar = _showTitleBar },
            "Diagram" => new { diagram = _diagram, title = EmptyToNull(_diagramTitle), showDiagramTitleBar = _showTitleBar, diagramType = _diagramType },
            "Table" => CreateTableContent(),
            "Callout" => new { kind = _kind, text = _text },
            "Summary" => new { summary = _summary },
            _ => new { markdown = _markdown }
        };

        return JsonSerializer.Serialize(content, JsonOptions);
    }

    private object CreateTableContent() => new
    {
        hasHeaderRow = _hasHeaderRow,
        hasHeaderColumn = _hasHeaderColumn,
        autoNumberRows = _autoNumberRows,
        tableStyle = _tableStyle,
        defaultHorizontalAlignment = _horizontalAlignment,
        defaultVerticalAlignment = "middle",
        rows = _tableRows.Select(row => row.Select(cell => new
        {
            text = cell.Text,
            emoji = EmptyToNull(cell.Emoji),
            imageUrl = EmptyToNull(cell.ImageUrl),
            imageAlt = EmptyToNull(cell.ImageAlt),
            horizontalAlignment = EmptyToNull(cell.HorizontalAlignment),
            verticalAlignment = EmptyToNull(cell.VerticalAlignment)
        }))
    };

    private static string NormalizeDiagramType(string? diagramType, string diagram)
    {
        if (string.Equals(diagramType, "mermaid", StringComparison.OrdinalIgnoreCase))
        {
            return "mermaid";
        }

        if (string.Equals(diagramType, "plantuml", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(diagramType, "plantUml", StringComparison.OrdinalIgnoreCase))
        {
            return "plantuml";
        }

        return diagram.TrimStart().StartsWith("@start", StringComparison.OrdinalIgnoreCase)
            ? "plantuml"
            : "mermaid";
    }

    private static string? String(JsonElement root, string name) => root.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;
    private static bool? Bool(JsonElement root, string name) => root.TryGetProperty(name, out var value) && value.ValueKind is JsonValueKind.True or JsonValueKind.False ? value.GetBoolean() : null;
    private static string? EmptyToNull(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class TableCellEditorModel
    {
        public string Text { get; set; } = string.Empty;
        public string Emoji { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public string ImageAlt { get; set; } = string.Empty;
        public string HorizontalAlignment { get; set; } = string.Empty;
        public string VerticalAlignment { get; set; } = string.Empty;
    }
}
