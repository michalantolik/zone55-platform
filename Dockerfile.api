# =============================================================================
# Zone55.Api — Multi-stage Dockerfile
# Build context: repo root
# =============================================================================

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS restore
WORKDIR /src

COPY src/LearnKit/LearnKit.Domain/LearnKit.Domain.csproj                         src/LearnKit/LearnKit.Domain/
COPY src/LearnKit/LearnKit.Application/LearnKit.Application.csproj               src/LearnKit/LearnKit.Application/
COPY src/LearnKit/LearnKit.Infrastructure/LearnKit.Infrastructure.csproj           src/LearnKit/LearnKit.Infrastructure/
COPY src/Zone55/Zone55.Api/Zone55.Api.csproj                                      src/Zone55/Zone55.Api/

RUN dotnet restore src/Zone55/Zone55.Api/Zone55.Api.csproj

FROM restore AS publish
WORKDIR /src

COPY src/LearnKit/ src/LearnKit/
COPY src/Zone55/Zone55.Api/ src/Zone55/Zone55.Api/

RUN dotnet publish src/Zone55/Zone55.Api/Zone55.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system appgroup && useradd --system --gid appgroup appuser

COPY --from=publish /app/publish .

RUN mkdir -p /app/logs \
    && chown -R appuser:appgroup /app/logs

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -f http://localhost:8080/health/live || exit 1

ENTRYPOINT ["dotnet", "Zone55.Api.dll"]
